# Core tools every Mac gets (Mac mini, MacBook Pro, MacBook Neo)
# Add a line here, commit, push — then run `brew bundle` on the other Macs.

# Command-line basics
brew "git"
brew "gh"            # GitHub CLI — sign-in, repos, PRs
brew "node"
brew "python"
brew "jq"
brew "wget"
brew "tree"
brew "mas"           # installs Mac App Store apps from the command line

# Apps
cask "visual-studio-code"
cask "claude-code"   # Claude Code in the terminal
